# Copy this file to .env and fill it in. .env is git-ignored; never commit it.

# Contact email sent to NCBI with every request (NCBI asks every client for one).
NCBI_EMAIL=

# Optional. Raises the limit from 3 to 10 requests per second.
# Create one at https://account.ncbi.nlm.nih.gov/settings/ (API Key Management).
NCBI_API_KEY=

# Optional. Name sent to NCBI to identify this program.
NCBI_TOOL=pubmed-scraper
